{
  "name": "fintech-microcreditos-grupo01",
  "version": "1.0.0",
  "description": "Este software es para una institución de microfinanzas guatemalteca que otorgará microcréditos a personas y pequeños negocios que no acceden fácilmente a la banca tradicional.",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc",
    "check": "tsc --noEmit",
    "start": "node --env-file-if-exists=.env dist/src/infraestructura/http/servidor.js",
    "mcp": "node --env-file-if-exists=.env dist/src/infraestructura/mcp/servidorMCP.js",
    "db:migrate": "node --env-file-if-exists=.env dist/scripts/migrar.js",
    "data:load": "node --env-file-if-exists=.env dist/src/infraestructura/carga-canonica/ejecutarCarga.js",
    "rag:ingest": "node --env-file-if-exists=.env dist/scripts/ingerir.js",
    "test:evals": "vitest run tests/evals",
    "test:integration": "vitest run tests/integracion",
    "pretest": "npm run build",
    "evals:live": "node --env-file-if-exists=.env dist/scripts/evaluar-modelo.js",
    "contracts": "npm run build && node dist/scripts/generar-contratos.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Willy4994/fintech-microcreditos-grupo01.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Willy4994/fintech-microcreditos-grupo01/issues"
  },
  "homepage": "https://github.com/Willy4994/fintech-microcreditos-grupo01#readme",
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@electric-sql/pglite-pgvector": "^0.0.16",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@langchain/ollama": "^1.3.0",
    "@langchain/textsplitters": "^1.0.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "date-fns": "^4.4.0",
    "decimal.js": "^10.6.0",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=22"
  }
}
